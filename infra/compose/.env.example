# Copy to .env and fill in. Loaded automatically when you run docker compose
# from this directory.

# Password for the containerized Postgres.
POSTGRES_PASSWORD=tcf_pass

# Anthropic key — used by the gateway container for text LLM calls (required to grade).
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME

# OpenAI key — backend Whisper STT / TTS (speaking path). Optional for writing grading.
OPENAI_API_KEY=

# Langfuse (optional; tracing is disabled when unset).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
