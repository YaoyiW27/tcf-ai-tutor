# Where the server-side proxy at /api/backend forwards to.
BACKEND_URL=http://localhost:8000

# Shared secret the proxy adds as X-API-Key. Must match the backend's API_KEY.
# Deliberately NOT prefixed NEXT_PUBLIC_ — that would inline it into the browser
# bundle and publish it. Leave unset locally if the backend has no API_KEY.
# BACKEND_API_KEY=

# Optional: bypass the proxy and call a backend directly from the browser. Only
# useful locally, and only when the backend has no API_KEY set.
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Basic-auth password for the deployed app. Unset locally = open. Set it on the
# deployment: the proxy attaches the backend key to whatever arrives, so a public
# URL without this is a public spend of model credits.
# APP_PASSWORD=
