# Which model backend to route to: anthropic (default) | openai | vllm
INFERENCE_BACKEND=anthropic

# Anthropic backend (default). The gateway holds this key now, not the app.
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME

# openai / vllm backends: forward to an OpenAI-compatible upstream.
# For self-hosted vLLM (see docs/vllm-runbook.md): set INFERENCE_BACKEND=vllm and:
# UPSTREAM_BASE_URL=http://<vllm-host>:8000/v1    # or https://api.openai.com/v1
# UPSTREAM_API_KEY=<vllm --api-key>
# The workload also sets INFERENCE_MODEL=Qwen/Qwen2.5-7B-Instruct (the model vLLM serves).

# Per-key token-bucket rate limiting.
RATE_LIMIT_PER_MIN=120
RATE_LIMIT_BURST=20
